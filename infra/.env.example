# DrayVision environment. `make setup` copies this to ./.env if missing.
# NEVER commit .env. Metered keys live ONLY on the API server — never in the mobile app.

# dev | pilot | prod  (unit tests force "test" and need none of the keys below)
DRAYVISION_ENV=dev

# --- Core infrastructure ---------------------------------------------------------------
# Host-side URLs (for running the API with `npm run dev:api`). docker compose overrides these
# with in-network addresses for the api container.
DATABASE_URL=postgres://drayvision:drayvision@localhost:5432/drayvision
REDIS_URL=redis://localhost:6379
VALHALLA_URL=http://localhost:8002
POSTGRES_USER=drayvision
POSTGRES_PASSWORD=drayvision
POSTGRES_DB=drayvision
API_PORT=8080
# Base URL the API advertises when no Host header is available.
PUBLIC_BASE_URL=http://localhost:8080

# --- Metered providers (required per environment: see services/api/config/*.ts) -------
# Base map tiles/styles — proxied through /tiles. Required from dev upward.
MAPTILER_KEY=
# Toll estimates (Phase 6) — required in pilot/prod.
TOLLSMART_API_KEY=
TOLLSMART_BASE_URL=
# Street-level imagery previews (Phase 9) — required in pilot/prod; rights unverified.
GOOGLE_MAPS_API_KEY=
# 511NY traffic events + cameras (Phases 7/8) — required in pilot/prod.
NY511_API_KEY=
