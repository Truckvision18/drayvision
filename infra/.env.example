# DrayVision environment. `make setup` copies this to ./.env if missing.
# NEVER commit .env. Metered keys live ONLY on the API server — never in the mobile app.

# dev | pilot | prod  (unit tests force "test" and need none of the keys below)
DRAYVISION_ENV=dev

# --- Core infrastructure ---------------------------------------------------------------
# Host-side URLs (for running the API with `npm run dev:api`). docker compose overrides these
# with in-network addresses for the api container.
DATABASE_URL=postgres://drayvision:drayvision@localhost:5432/drayvision
REDIS_URL=redis://localhost:6379
VALHALLA_URL=http://localhost:8002
POSTGRES_USER=drayvision
POSTGRES_PASSWORD=drayvision
POSTGRES_DB=drayvision
API_PORT=8080
# Base URL the API advertises when no Host header is available.
PUBLIC_BASE_URL=http://localhost:8080

# --- Base map tiles (switch source / delivery here — no code change, no app release) ----
# TILE_SOURCE: maptiler | self-hosted | mock     TILE_DELIVERY: proxy | direct (maptiler only)
TILE_SOURCE=maptiler
TILE_DELIVERY=proxy
# Server-side MapTiler key (proxy delivery). Required when TILE_SOURCE=maptiler + proxy.
MAPTILER_KEY=
# MapTiler's written approval for proxy use (Cloud Terms §6) — pilot/prod refuse proxy mode without it.
MAPTILER_PROXY_APPROVAL_REF=
# Restricted, client-safe MapTiler key handed to the app. Required when TILE_DELIVERY=direct.
MAPTILER_CLIENT_KEY=
# Our own tile server (the exit ramp). Required when TILE_SOURCE=self-hosted.
SELF_HOSTED_TILES_URL=
# Guards GET /usage/maps (all devices) outside dev/test.
OPS_TOKEN=

# --- Metered providers (required per environment: see services/api/config/*.ts) -------
# Toll estimates (Phase 6) — required in pilot/prod.
TOLLSMART_API_KEY=
TOLLSMART_BASE_URL=
# Street-level imagery previews (Phase 9) — required in pilot/prod; rights unverified.
GOOGLE_MAPS_API_KEY=
# 511NY traffic events + cameras (Phases 7/8) — required in pilot/prod.
NY511_API_KEY=
